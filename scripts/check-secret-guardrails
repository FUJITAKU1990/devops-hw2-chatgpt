#!/usr/bin/env bash
set -euo pipefail

FILE="docker-compose.yml"
INTEGRITY_FILE="scripts/check-ci-integrity"
FAIL=0

REQUIRED_VARS=(
  POSTGRES_PASSWORD
  JWT_SECRET
  PAYMENT_DB_PASSWORD
  TARTANPAY_API_KEY
  TARTANPAY_ADMIN_TOKEN
  TARTAN_ADMIN_PASSWORD
  MP_UI_AUTH
  STUDENT_FIXTURE_PASSWORD
  RELEASE_OPERATOR_PASSWORD
  SUPPORT_AGENT_PASSWORD
)

for VAR in "${REQUIRED_VARS[@]}"; do
  if ! grep -qE "\\\$\{${VAR}:\?" "$FILE"; then
    echo "FAIL: ${VAR} is not required (\${${VAR}:?...}) in ${FILE}"
    FAIL=1
  fi
  if grep -qE "\\\$\{${VAR}:-" "$FILE"; then
    echo "FAIL: ${VAR} has a weak default (\${${VAR}:-...}) in ${FILE}"
    FAIL=1
  fi
done

if ! grep -qE '\$\{TARTANPAY_LOG_SECRETS:-false\}' "$FILE"; then
  echo "FAIL: TARTANPAY_LOG_SECRETS default is not false in ${FILE}"
  FAIL=1
fi

# --- app source: no hardcoded fallback values for secret-like env vars ---
# docker-compose.yml enforcing `${VAR:?...}` is meaningless if the service
# code itself falls back to a fixed literal whenever the process is started
# outside Compose (e.g. `process.env.JWT_SECRET || 'some-fixed-value'`).
# Flag any `process.env.<NAME> || ...` where <NAME> looks like a secret.
SENSITIVE_ENV_PATTERN='process\.env\.[A-Za-z0-9_]*(SECRET|PASSWORD|TOKEN|API_KEY|DATABASE_URL)[A-Za-z0-9_]*[[:space:]]*\|\|'
APP_SOURCE_MATCHES=$(grep -rnE "$SENSITIVE_ENV_PATTERN" services database packages --include='*.ts' 2>/dev/null | grep -vE '/(node_modules|dist)/' || true)
if [ -n "$APP_SOURCE_MATCHES" ]; then
  echo "FAIL: hardcoded fallback found for a secret-like environment variable in application source:"
  echo "$APP_SOURCE_MATCHES"
  FAIL=1
fi

# --- cross-check: ci-integrity-check's own detectors must still be intact ---
# check-secret-guardrails and check-ci-integrity verify each other's critical
# content, so weakening one alone (by accident or otherwise) is still caught
# by the other job.
if [ -f "$INTEGRITY_FILE" ]; then
  for PATTERN in 'continue-on-error' '\|\| true' 'set \+e' 'gitleaks detect' '\-\-exit\-code 1'; do
    if ! grep -qE -- "$PATTERN" "$INTEGRITY_FILE"; then
      echo "FAIL: ${INTEGRITY_FILE} no longer checks for '${PATTERN}'"
      FAIL=1
    fi
  done
else
  echo "FAIL: ${INTEGRITY_FILE} not found"
  FAIL=1
fi

exit $FAIL
