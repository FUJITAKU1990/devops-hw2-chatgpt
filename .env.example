# ── Database ──────────────────────────────────────────────────────────────────
# Compose services use these values to construct their internal URLs.
POSTGRES_USER=tartan
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tartantickets

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=tartan-f26-dev-signing-key

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL used in activation emails. Point this at the public frontend origin.
APP_URL=http://localhost:8636
# Leave blank to use the frontend's same-origin /api proxy.
VITE_API_URL=

# ── TartanPay (fake Stripe-like payment provider) ────────────────────────────
# TartanPay uses a separate datastore and credentials from the application DB.
PAYMENT_DB_USER=tartanpay
PAYMENT_DB_PASSWORD=tartanpay-dev-password
PAYMENT_DB_NAME=tartanpay
TARTANPAY_API_KEY=tp_sk_test_f26_public_release_7Qm4Vx9L2cN8rK5D
TARTANPAY_ADMIN_TOKEN=tp_admin_test_f26_public_release_4Wd8Hs2J7pRx6MzC
PAYMENT_SERVICE_IMAGE=ghcr.io/cmu-devops/tartanpay:latest

# Bootstrap admin user created by the migrator.
TARTAN_ADMIN_EMAIL=admin@cmu.edu
TARTAN_ADMIN_PASSWORD=admin
TARTAN_ADMIN_NAME=Admin

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
SMTP_FROM=noreply@tartantickets.cmu.edu
MP_UI_AUTH=admin:admin
