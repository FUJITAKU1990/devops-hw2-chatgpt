#!/usr/bin/env bash
set -euo pipefail

FILE="docker-compose.yml"
FAIL=0

REQUIRED_VARS=(
  POSTGRES_PASSWORD
  JWT_SECRET
  PAYMENT_DB_PASSWORD
  TARTANPAY_API_KEY
  TARTANPAY_ADMIN_TOKEN
  TARTAN_ADMIN_PASSWORD
  MP_UI_AUTH
  STUDENT_FIXTURE_PASSWORD
)

for VAR in "${REQUIRED_VARS[@]}"; do
  if ! grep -qE "\\\$\{${VAR}:\?" "$FILE"; then
    echo "FAIL: ${VAR} is not required (\${${VAR}:?...}) in ${FILE}"
    FAIL=1
  fi
  if grep -qE "\\\$\{${VAR}:-" "$FILE"; then
    echo "FAIL: ${VAR} has a weak default (\${${VAR}:-...}) in ${FILE}"
    FAIL=1
  fi
done

if ! grep -qE '\$\{TARTANPAY_LOG_SECRETS:-false\}' "$FILE"; then
  echo "FAIL: TARTANPAY_LOG_SECRETS default is not false in ${FILE}"
  FAIL=1
fi

exit $FAIL
