#!/usr/bin/env bash
#
# Fill in any still-blank required secret in an .env file with a securely
# random value. Idempotent: a var that already has a value is left alone
# (the sed patterns only match a bare `VAR=` line), so this is safe to run
# more than once (e.g. every Dev Container rebuild).
#
# Used by:
#   - .github/workflows/ci.yml ("Prepare env" step)
#   - .devcontainer/devcontainer.json (postCreateCommand)
# so nobody has to hand-edit .env before the stack can start.
set -euo pipefail

ENV_FILE="${1:-.env}"

sed -i "s|^POSTGRES_PASSWORD=\$|POSTGRES_PASSWORD=$(openssl rand -hex 16)|" "$ENV_FILE"
sed -i "s|^JWT_SECRET=\$|JWT_SECRET=$(openssl rand -hex 32)|" "$ENV_FILE"
sed -i "s|^PAYMENT_DB_PASSWORD=\$|PAYMENT_DB_PASSWORD=$(openssl rand -hex 16)|" "$ENV_FILE"
sed -i "s|^TARTANPAY_API_KEY=\$|TARTANPAY_API_KEY=tp_sk_ci_$(openssl rand -hex 16)|" "$ENV_FILE"
sed -i "s|^TARTANPAY_ADMIN_TOKEN=\$|TARTANPAY_ADMIN_TOKEN=tp_admin_ci_$(openssl rand -hex 16)|" "$ENV_FILE"
sed -i "s|^TARTAN_ADMIN_PASSWORD=\$|TARTAN_ADMIN_PASSWORD=$(openssl rand -hex 12)|" "$ENV_FILE"
sed -i "s|^MP_UI_AUTH=\$|MP_UI_AUTH=admin:$(openssl rand -hex 12)|" "$ENV_FILE"
sed -i "s|^STUDENT_FIXTURE_PASSWORD=\$|STUDENT_FIXTURE_PASSWORD=$(openssl rand -hex 12)|" "$ENV_FILE"
sed -i "s|^RELEASE_OPERATOR_PASSWORD=\$|RELEASE_OPERATOR_PASSWORD=$(openssl rand -hex 12)|" "$ENV_FILE"
sed -i "s|^SUPPORT_AGENT_PASSWORD=\$|SUPPORT_AGENT_PASSWORD=$(openssl rand -hex 12)|" "$ENV_FILE"
